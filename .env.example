# Odicto — your private config (edit by hand or via the setup page).
# Blank or missing → built-in default applies. Use: python odicto.py config
# to see what's actually live after a save (restart Odicto to apply changes).

# 1. AI backend ----------------------------------------------------------
# none | ollama | openrouter | meta | gemini
LLM_PROVIDER=none

# 2. Model & generation (filled by the setup page) ----------------------
# Set once here as the true default — only API keys start blank below.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
LLM_MAX_TOKENS=1024
LLM_NUM_CTX=2048
LLM_API_BASE=http://localhost:11434/v1

# 3. Keys & per-backend models — one row per backend --------------------
# Paste the key for the backend you use; non-active backends keep their
# stored settings. Only the three *_API_KEY rows intentionally start empty.
META_API_KEY=
META_MODEL=muse-spark-1.3-contributor
META_MODEL_HISTORY=
META_REASONING_EFFORT=low

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_MODEL_HISTORY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Always pick the lowest-latency host for the chosen model (not cheapest).
OPENROUTER_PROVIDER_SORT=latency
# Skip thinking when the model allows it. GLM-5.3 rejects none; the client retries at low.
OPENROUTER_REASONING_EFFORT=none

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# 4. Dictation / AI chords (keyboard name for ` is "grave") -------------
# true = tap the chord to start, tap the same chord again to stop (like F7).
# false = hold the chord while you speak, release to stop.
# Avoid bare Alt chords in browsers.
HOTKEY_TOGGLE=true
HOTKEY=ctrl+grave
AI_HOTKEY=ctrl+shift+grave
AI_MODIFIER=
RESET_CONTEXT_HOTKEY=f5
# Hold these DURING a capture to keep conversation memory:
CTRL_KEEP_CONTEXT_KEYS=f6

# 5. Audio & speech-to-text ----------------------------------------------
SAMPLE_RATE=16000
CHANNELS=1
WHISPER_MODEL_SIZE=tiny.en
# auto: tiny/base stay on CPU (avoids a ~1GB CUDA context). Larger models try GPU.
# cuda: load the model into GPU memory at startup and warm it, so the first
# hotkey is not waiting on CUDA. cpu pins the processor.
WHISPER_DEVICE=auto
WHISPER_VAD=false
# whisper | gemini | groq | openrouter | auto
# auto = Gemini STT when GEMINI_API_KEY is set, else Whisper.
# The resolved provider and model are used for raw dictation and AI mode.
STT_PROVIDER=whisper
# F7 engine. auto = the same provider and model as STT_PROVIDER.
# gemini streams. groq, openrouter, and whisper transcribe the clip on release.
LIVE_STT_PROVIDER=auto
# Groq Whisper. Key stays blank until you paste one on the setup page.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
# OpenRouter speech model. Uses OPENROUTER_API_KEY. Separate from the chat model.
# Grok speech models go here too, for example x-ai/grok-stt-1.0.
OPENROUTER_STT_MODEL=openai/whisper-large-v3
# smart = cleaned dictation (ums/self-corrections gone); verbatim = literal
GEMINI_TRANSCRIBE_MODE=smart
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSCRIBE_LANGUAGE=
GEMINI_TRANSCRIBE_VOCABULARY=
# Tap once to start, tap again to stop and paste. Empty disables.
LIVE_HOTKEY=f7

# 6. Timing & feedback ---------------------------------------------------
# Seconds to wait after the paste chord before your previous clipboard is
# restored (restore runs in the background; minimum 0.15, maximum 10).
PASTE_DELAY_SECONDS=1.0
# A capture stops itself after this many seconds and is transcribed. 0 = no limit (max 7200).
MAX_RECORDING_SECONDS=600
# Time limit (3-300 s) for one speech-to-text stage before local Whisper is used.
STT_DEADLINE_SECONDS=20
# Time limit (3-600 s) for one AI reply or polish stage; on timeout the raw transcript is kept.
LLM_DEADLINE_SECONDS=30
# Key that cancels a running PROCESSING stage. Never suppressed. Blank disables.
CANCEL_HOTKEY=esc
# false = dictation.log records only lengths and timings, never transcript or AI text.
LOG_TRANSCRIPTS=false
# Polish is skipped for transcripts longer than this many characters. 0 = no limit (max 100000).
POLISH_MAX_CHARS=1200
PLAY_AUDIO_CUES=true
SHOW_VISUAL_INDICATOR=true
MIN_HOLD_MS=80
RETRIGGER_COOLDOWN_MS=120
# When the focused window is a terminal, type the text instead of pasting:
# no paste chord is universal there and Ctrl+C is SIGINT. Clipboard untouched.
TYPE_IN_TERMINAL=true
# Extra window classes / process names to also treat as terminals (comma-separated)
EXTRA_TERMINAL_APPS=

# 7. AI persona / instructions -------------------------------------------
# prompt.txt (gitignored) is the private live prompt if it exists.
# Otherwise prompt.txt.example (shipped default) is used.
# Setup Save writes prompt.txt and sets SYSTEM_PROMPT_FILE=prompt.txt.
# Leave SYSTEM_PROMPT blank; do not duplicate the body here.
SYSTEM_PROMPT_FILE=
SYSTEM_PROMPT=

# 8. Advanced hand-edit knobs (rarely needed) ------------------------
# Per-provider ceilings that override LLM_MAX_TOKENS for that backend:
# GEMINI_MAX_OUTPUT_TOKENS=4096
# Provider endpoint overrides:
# META_API_BASE=https://api.meta.ai/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Generic tiers still honored (per-provider keys above win when set):
# LLM_MODEL=qwen2.5:1.5b-instruct
# LLM_REASONING_EFFORT=minimal|low|medium|high|none
# Local setup page port:
# SETUP_PORT=8765

# Optional grammar, punctuation and capitalization only; uses the selected AI provider.
# POLISH_MODEL blank follows its AI model. Waits at most 2 seconds, then uses raw text.
POLISH_DICTATION=false
POLISH_MODEL=
# Groq chat is independent of its speech model and shares GROQ_API_KEY.
GROQ_MODEL=openai/gpt-oss-20b

# Explicitly attach the clipboard screenshot to AI queries (requires HUD).
AI_CLIPBOARD_IMAGE=false
