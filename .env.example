# Hold-to-talk chords (press+hold primary while modifiers are down, release to process)
# keyboard library name for the ` key is "grave" (aliases: ` , backtick)
# Avoid bare Alt chords in browsers: Alt release often steals focus from the text field.
# Dictation: Ctrl+` · AI: Ctrl+Shift+`
HOTKEY=ctrl+grave
AI_HOTKEY=ctrl+shift+grave
# Legacy optional extra key (leave empty when AI_HOTKEY is set)
AI_MODIFIER=
# Press to instantly clear the AI multi-turn memory (no recording needed).
# Empty = disabled. Must not be the dictation primary key.
RESET_CONTEXT_HOTKEY=f5
# Extra key held during a capture KEEPS AI conversation memory (opt-in).
# Default AI (Ctrl+Shift+`) is always a fresh one-shot with no prior turns.
# Hold F6 + Ctrl+` (or F6 + the AI chord) to continue the previous F6 chat.
# Empty = disabled. Comma-separated.
CTRL_KEEP_CONTEXT_KEYS=f6

# Audio settings
SAMPLE_RATE=16000
CHANNELS=1

# Local Whisper settings
# 'tiny.en' (fastest English), 'base.en', 'small.en'
WHISPER_MODEL_SIZE=tiny.en
# 'cpu' or 'cuda' (auto-detected if blank)
WHISPER_DEVICE=auto
# Silero VAD before decode. Leave false for fastest hold-to-talk (clips < 8s
# skip VAD anyway). true always runs VAD.
WHISPER_VAD=false

# Refinement LLM settings
# Flip this to switch backends: 'ollama' | 'openrouter' | 'meta' | 'gemini' | 'none'
# Default is meta (Meta API).
# Aliases: meta -> meta, meta-api, meta_api · gemini -> gemini, google, google-api
LLM_PROVIDER=meta
# Ollama model tag (local). Examples: qwen2.5:1.5b-instruct , llama3.2:3b , phi4-mini
LLM_MODEL=qwen2.5:1.5b-instruct
# OpenRouter model slug (cloud). Used when LLM_PROVIDER=openrouter.
# Browse models: https://openrouter.ai/models
# One slug only. Do NOT append old models with # on the same line
# (dotenv keeps "model#other" as one invalid id). Comment old ones on their own line:
# OPENROUTER_MODEL=nvidia/some-old-model:free
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Local Ollama OpenAI-compatible endpoint (ignored for openrouter when still localhost)
LLM_API_BASE=http://localhost:11434/v1
# OpenRouter OpenAI-compatible endpoint (default is fine for most users)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Max response token limit (hard ceiling on the pasted reply).
# ~1 token ≈ 0.75 English words. 1024 ≈ a mid-length social post / 150-word
# rewrite with headroom so answers are not cut off. Raise for long essays.
LLM_MAX_TOKENS=1024
# Ollama context window (higher = smarter multi-turn, slightly slower)
LLM_NUM_CTX=2048
# Required when LLM_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# --- Meta API (default provider) ---
# Get a key and docs from Meta; paste it here. MODEL_API_KEY is also accepted as alias.
# Example: POST https://api.meta.ai/v1/responses  {model: "muse-spark-1.2-contributor", input: [...], reasoning:{effort:"low"}}
META_API_KEY=
# MODEL_API_KEY=  # alias for META_API_KEY — either works
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.2-contributor
META_REASONING_EFFORT=low
META_MAX_OUTPUT_TOKENS=4096

# --- Google Gemini API ---
# Get a key at https://aistudio.google.com/apikey and paste it here.
# GOOGLE_API_KEY is also accepted as alias for GEMINI_API_KEY.
# Uses the GA Interactions API (google-genai SDK): POST .../v1beta/interactions
#   {model: "gemini-3.5-flash-lite", input: "...", system_instruction: "...", generation_config: {thinking_level: "minimal"}}
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alias for GEMINI_API_KEY — either works
GEMINI_MODEL=gemini-3.5-flash-lite
# How much thinking the model may do: minimal | low | medium | high
# (flash-lite is a non-reasoning model — 'minimal' is the fastest setting)
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=4096

# Timing & Feedback
PASTE_DELAY_SECONDS=0.05
PLAY_AUDIO_CUES=true
SHOW_VISUAL_INDICATOR=true
# Ignore accidental taps shorter than this (milliseconds)
MIN_HOLD_MS=80
# Cooldown between finished cycle and next capture (milliseconds)
RETRIGGER_COOLDOWN_MS=120

# AI-mode system prompt (Ctrl+Shift+`). Leave empty to use the built-in default.
# Edit here or in the setup page (setup.bat / setup.sh). Restart Odicto after changes.
# Use a double-quoted value with \n for line breaks, for example:
# SYSTEM_PROMPT="You are a concise assistant.\nReply in plain text only."
SYSTEM_PROMPT=

# Local setup web page (odicto.py setup). Optional; the code defaults to 8765.
# SETUP_PORT=8765
