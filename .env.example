# Hold-to-talk chords (press+hold primary while modifiers are down, release to process)
# keyboard library name for the ` key is "grave" (aliases: ` , backtick)
# Avoid bare Alt chords in browsers: Alt release often steals focus from the text field.
# Dictation: Ctrl+` · AI: Ctrl+Shift+`
HOTKEY=ctrl+grave
AI_HOTKEY=ctrl+shift+grave
# Legacy optional extra key (leave empty when AI_HOTKEY is set)
AI_MODIFIER=
# Press to instantly clear the AI multi-turn memory (no recording needed).
# Empty = disabled. Must not be the dictation primary key.
RESET_CONTEXT_HOTKEY=f5
# Extra key held during a capture forces a FRESH AI reply (memory wiped first,
# one-shot only). Example: hold F6 while using the AI chord. Comma-separated.
# Empty = disabled.
CTRL_FORCE_FRESH_KEYS=f6

# Audio settings
SAMPLE_RATE=16000
CHANNELS=1

# Local Whisper settings
# 'tiny.en' (fastest English), 'base.en', 'small.en'
WHISPER_MODEL_SIZE=tiny.en
# 'cpu' or 'cuda' (auto-detected if blank)
WHISPER_DEVICE=auto

# Refinement LLM settings
# Flip this to switch backends: 'ollama' | 'openrouter' | 'meta' | 'none'
# Default is meta (Meta API). Aliases for meta: meta, meta-api, meta_api
LLM_PROVIDER=meta
# Ollama model tag (local). Examples: qwen2.5:1.5b-instruct , llama3.2:3b , phi4-mini
LLM_MODEL=qwen2.5:1.5b-instruct
# OpenRouter model slug (cloud). Used when LLM_PROVIDER=openrouter.
# Browse models: https://openrouter.ai/models
# One slug only. Do NOT append old models with # on the same line
# (dotenv keeps "model#other" as one invalid id). Comment old ones on their own line:
# OPENROUTER_MODEL=nvidia/some-old-model:free
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Local Ollama OpenAI-compatible endpoint (ignored for openrouter when still localhost)
LLM_API_BASE=http://localhost:11434/v1
# OpenRouter OpenAI-compatible endpoint (default is fine for most users)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Max response token limit (hard ceiling on reply length)
LLM_MAX_TOKENS=1536
# Ollama context window (higher = smarter multi-turn, slightly slower)
LLM_NUM_CTX=2048
# Required when LLM_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# --- Meta API (default provider) ---
# Get a key and docs from Meta; paste it here. MODEL_API_KEY is also accepted as alias.
# Example: POST https://api.meta.ai/v1/responses  {model: "muse-spark-1.2-contributor", input: [...], reasoning:{effort:"low"}}
META_API_KEY=
# MODEL_API_KEY=  # alias for META_API_KEY — either works
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.2-contributor
META_REASONING_EFFORT=low
META_MAX_OUTPUT_TOKENS=4096

# Timing & Feedback
PASTE_DELAY_SECONDS=0.05
PLAY_AUDIO_CUES=true
SHOW_VISUAL_INDICATOR=true
# Ignore accidental taps shorter than this (milliseconds)
MIN_HOLD_MS=80
# Cooldown between finished cycle and next capture (milliseconds)
RETRIGGER_COOLDOWN_MS=120
