# Odicto — your private config (edit by hand or via the setup page).
# Blank or missing → built-in default applies. Use: python odicto.py config
# to see what's actually live after a save (restart Odicto to apply changes).

# 1. AI backend ----------------------------------------------------------
# none | ollama | openrouter | meta | gemini
LLM_PROVIDER=none

# 2. Model & generation (filled by the setup page) ----------------------
# Set once here as the true default — only API keys start blank below.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
LLM_MAX_TOKENS=1024
LLM_NUM_CTX=2048
LLM_API_BASE=http://localhost:11434/v1

# 3. Keys & per-backend models — one row per backend --------------------
# Paste the key for the backend you use; non-active backends keep their
# stored settings. Only the three *_API_KEY rows intentionally start empty.
META_API_KEY=
META_MODEL=muse-spark-1.2-contributor
META_MODEL_HISTORY=
META_REASONING_EFFORT=low

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_MODEL_HISTORY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# 4. Hold-to-talk chords (keyboard name for ` is "grave") ---------------
# Hold the chord, speak, release. Avoid bare Alt chords in browsers.
HOTKEY=ctrl+grave
AI_HOTKEY=ctrl+shift+grave
AI_MODIFIER=
RESET_CONTEXT_HOTKEY=f5
# Hold these DURING a capture to keep conversation memory:
CTRL_KEEP_CONTEXT_KEYS=f6

# 5. Audio & speech-to-text ----------------------------------------------
SAMPLE_RATE=16000
CHANNELS=1
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=auto
WHISPER_VAD=false
# whisper | gemini | auto  (auto = Gemini STT when GEMINI_API_KEY is set)
STT_PROVIDER=whisper
# smart = cleaned dictation (ums/self-corrections gone); verbatim = literal
GEMINI_TRANSCRIBE_MODE=smart
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSCRIBE_LANGUAGE=
GEMINI_TRANSCRIBE_VOCABULARY=
# Tap once to start, tap again to stop and paste. Empty disables.
LIVE_HOTKEY=f7

# 6. Timing & feedback ---------------------------------------------------
PASTE_DELAY_SECONDS=0.05
PLAY_AUDIO_CUES=true
SHOW_VISUAL_INDICATOR=true
MIN_HOLD_MS=80
RETRIGGER_COOLDOWN_MS=120

# 7. AI persona / instructions -------------------------------------------
# prompt.txt (gitignored) is the private live prompt if it exists.
# Otherwise prompt.txt.example (shipped default) is used.
# Setup Save writes prompt.txt and sets SYSTEM_PROMPT_FILE=prompt.txt.
# Leave SYSTEM_PROMPT blank; do not duplicate the body here.
SYSTEM_PROMPT_FILE=
SYSTEM_PROMPT=

# 8. Advanced hand-edit knobs (rarely needed) ------------------------
# Per-provider ceilings that override LLM_MAX_TOKENS for that backend:
# META_MAX_OUTPUT_TOKENS=4096
# GEMINI_MAX_OUTPUT_TOKENS=4096
# Provider endpoint overrides:
# META_API_BASE=https://api.meta.ai/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Generic tiers still honored (per-provider keys above win when set):
# LLM_MODEL=qwen2.5:1.5b-instruct
# LLM_REASONING_EFFORT=minimal|low|medium|high|none
# Local setup page port:
# SETUP_PORT=8765
